# =============================================================================
#  cluster.env — the ONLY file you normally edit.
#  Sourced by every script on both boards. Keep it identical on both boards
#  (just `git pull` on both).
# =============================================================================

# ---- Board roles -------------------------------------------------------------
# Board A = PCIe Root Port (RP) + Ray head + experiment orchestrator
# Board B = PCIe Endpoint  (EP) + Ray worker  (flashed with EP ODMDATA)
#
# Control-plane IPs (10GbE). Ray, torch rendezvous, NCCL bootstrap (Exp 2),
# SSH and HTTP always use these.
RP_CTRL_IP="10.0.0.1"
EP_CTRL_IP="10.0.0.2"
CTRL_PREFIX="24"
# 10GbE interface name on each board (AGX Orin devkit RJ45 is usually eth0).
# Leave empty to auto-detect from the CTRL IP.
RP_CTRL_IF=""
EP_CTRL_IF=""

# SSH user on Board B (orchestrator on A runs commands on B over SSH).
EP_SSH_USER="${USER}"
# Absolute path of this repo on Board B (clone to the same path on both boards).
EP_REPO_DIR=""          # empty = same path as on Board A

# ---- PCIe / Tegra VNET (Exp 1) ------------------------------------------------
PCIE_EP_ADDR="141a0000"          # AGX Orin C5 controller (EP side)
PCIE_RP_BDF="0005:01:00.0"       # how the EP appears on the RP side
RP_VNET_IP="192.168.2.2"
EP_VNET_IP="192.168.2.1"
VNET_PREFIX="24"

# ---- Container ---------------------------------------------------------------
# Image with Jetson-patched NCCL 2.27.7 + PyTorch + vLLM (from dusty-nv
# jetson-containers distributed-inference doc). See docker/README.md to build
# your own instead.
IMAGE="mitakad/vllm:0.11.2-r36.4.tegra-aarch64-cp310-cu126-22.04-truncated"
CONTAINER_NAME="jdi-node"
# Host dir mounted at /data in the container (models, HF cache, encodings).
DATA_DIR="${HOME}/jdi-data"

# ---- Models ------------------------------------------------------------------
LLM_MODEL="openai/gpt-oss-20b"
VIT_MODELS="google/vit-base-patch16-224 google/vit-huge-patch14-224-in21k"
HF_TOKEN="${HF_TOKEN:-}"          # optional; export it in your shell instead of committing

# ---- Benchmark knobs ---------------------------------------------------------
REPEATS=3                         # each measurement repeated N times

# all-reduce sweep (bytes)
AR_MIN_BYTES=8
AR_MAX_BYTES=268435456            # 256 MiB
AR_DTYPE="float16"

# ViT sweep
VIT_BATCHES="1 4 8 16 32 64"
VIT_DTYPE="float16"
VIT_ITERS=30

# vLLM sweep (vllm bench serve, random dataset)
LLM_INPUT_LENS="128 256 512 1024 2048 4096 8192"   # x2 steps up to ~8K
LLM_MAX_MODEL_LEN=8448            # >= max input + output
LLM_OUTPUT_LEN=128
LLM_CONCURRENCY="1 4 8"
LLM_NUM_PROMPTS_PER_CONC=4        # num_prompts = concurrency * this (min 8)
LLM_KV_CACHE_BYTES="6G"           # 8 concurrent x ~8.3K tokens fits even at TP=1
LLM_GPU_MEM_UTIL="0.5"
# "tp"    = pure tensor parallel (main result)
# "tp_ep" = TP + --enable-expert-parallel (dusty-nv reference config)
LLM_PARALLEL_MODES="tp tp_ep"
# communication share: torch-profiler traces (one prefill-only and one full request per input length)
LLM_PROFILE=1
LLM_PROFILE_INPUT_LENS="${LLM_INPUT_LENS}"
LLM_PROFILE_PROMPTS=2
# correctness: fixed prompts, greedy decoding (bench/data/llm_prompts.json)
LLM_CORRECTNESS=1
LLM_CORRECTNESS_MAX_TOKENS=512

# iperf3
IPERF_DURATION=20

# NVIDIA eDMA test (Exp 2a)
DMA_SIZE=16777216                 # bytes per transfer
DMA_NENTS=4
DMA_STRESS=1000
DMA_EDMA_CH="0x11"                # see docs/02_dma_test.md
